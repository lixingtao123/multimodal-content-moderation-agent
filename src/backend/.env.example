# 内容风控智能治理系统 — 环境变量模板
# 用法: cp .env.example .env 然后填入真实密钥。
# 真实密钥只放在 .env（已 gitignore），绝不进入代码或 commit。

# ========== LLM 密钥（必填） ==========
# DeepSeek API（文本理解 / Agent 推理）
DEEPSEEK_API_KEY=<你的DeepSeek API Key>
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Qwen3-VL API（阿里云 MaaS 多模态：图像 / 视频帧 / OCR）
# 获取：阿里云 PAI-MaaS 控制台 → 模型服务 → Workspace → API Keys
QWEN_VL_API_KEY=<你的阿里云MaaS Qwen-VL API Key>
QWEN_VL_BASE_URL=https://{workspace-id}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3.6-plus

# ========== 连接地址（本地模式） ==========
# 本地模式（start.sh）使用 localhost；Docker 模式由 docker-compose.yml 覆盖为容器名。

# PostgreSQL（本地模式）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:15432/moderation
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:15432/moderation

# Redis（本地模式）
REDIS_URL=redis://localhost:16379/0

# ChromaDB：本地模式走嵌入式 PersistentClient（start.sh export CHROMA_PERSIST_DIR），
# 无需独立服务。此 URL 仅 Docker 模式（docker-compose.yml 覆盖为 http://chromadb:8000）时使用。
CHROMA_URL=http://localhost:18001

# 多模态 Agent 模式控制（false=真实 VL API；仅调试用 true 走 mock）
IMAGE_AGENT_MOCK=false

# FunASR（本地进程）
FUNASR_URL=http://localhost:15001

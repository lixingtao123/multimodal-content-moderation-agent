# 内容风控智能治理系统 — 环境变量配置

# DeepSeek API（文本理解 / Agent 推理）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Qwen3-VL API（多模态：图像 / 视频帧 / OCR）
QWEN_VL_API_KEY=sk-your-key-here
QWEN_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# PostgreSQL
POSTGRES_DB=moderation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_URL=redis://redis:6379/0

# ChromaDB
CHROMA_URL=http://chromadb:8000

# FunASR
FUNASR_URL=http://funasr:5001

# ============ 端口配置（可选） ============
# start.sh 支持同名环境变量与命令行参数，命令行参数优先级更高
# 默认值已选高位端口降低冲突概率（规则: 原端口前加前缀 1）
# BACKEND_PORT=18080
# FRONTEND_PORT=13000
# FUNASR_PORT=15001
# PG_PORT=15432
# REDIS_PORT=16379
# CHROMA_PORT=18001
# 示例: bash start.sh --backend-port 19090 --frontend-port 14000 \
#                     --funasr-port 16001 --pg-port 16432 --redis-port 17379 --chroma-port 19001
